---
import type { Dictionary, Locale } from '../i18n';
import { withBase } from '../utils/paths';

interface Props {
  t: Dictionary;
  locale: Locale;
}

const { t, locale } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://rripollesg.github.io';
let base = import.meta.env.BASE_URL || '/';
if (!base.endsWith('/')) base += '/';
const pageUrl = locale === 'es' ? `${site}${base}` : `${site}${base}en/`;
const esUrl = `${site}${base}`;
const enUrl = `${site}${base}en/`;
const ogImagePath = t.meta.ogImage ?? 'assets/img/og-cover-es.jpg';
const ogImage = `${site}${base}${ogImagePath.replace(/^\//, '')}`;
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlt = locale === 'es' ? 'en_US' : 'es_ES';
const sameAs = [t.social.linkedin, t.social.github].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t.profile.name,
  alternateName: t.profile.shortName,
  url: pageUrl,
  image: ogImage,
  jobTitle: t.profile.role.replace(/\.$/, ''),
  description: t.meta.description,
  email: t.social.email.replace(/^mailto:/, ''),
  telephone: t.social.phone.replace(/^tel:/, ''),
  sameAs,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Valencia',
    addressCountry: 'ES',
  },
  knowsAbout: ['HIS', 'QA', 'SQL', 'Flutter', 'Healthcare IT'],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{t.meta.title}</title>
    <meta content={t.meta.keywords} name="keywords" />
    <meta name="description" content={t.meta.description} />
    <meta name="author" content="Raúl Ripollés García" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#149ddd" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Raúl Ripollés García" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt ?? t.profile.imageAlt} />
    <meta property="profile:first_name" content="Raúl" />
    <meta property="profile:last_name" content="Ripollés" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt ?? t.profile.imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link href={withBase('assets/img/favicon.png')} rel="icon" />
    <link href={withBase('assets/img/favicon.png')} rel="shortcut icon" />
    <link href={withBase('assets/img/apple-touch-icon.png')} rel="apple-touch-icon" />

    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap"
      />
    </noscript>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link href={withBase('assets/vendor/aos/aos.css')} rel="stylesheet" />
    <link href={withBase('assets/vendor/bootstrap/css/bootstrap.min.css')} rel="stylesheet" />
    <link href={withBase('assets/vendor/bootstrap-icons/bootstrap-icons.css')} rel="stylesheet" />
    <link href={withBase('assets/vendor/boxicons/css/boxicons.min.css')} rel="stylesheet" />
    <link href={withBase('assets/vendor/swiper/swiper-bundle.min.css')} rel="stylesheet" />
    <link href={`${withBase('assets/css/style.css')}?v=6.0.7`} rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.14.0/devicon.min.css"
    />
    <style is:global>
      #hero #canvas {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        z-index: 2;
        pointer-events: none;
        opacity: 0.35;
      }
    </style>
  </head>
  <body>
    <slot />

    <script is:inline src={withBase('assets/vendor/aos/aos.js')}></script>
    <script is:inline src={withBase('assets/vendor/bootstrap/js/bootstrap.bundle.min.js')}></script>
    <script is:inline src={withBase('assets/vendor/isotope-layout/isotope.pkgd.min.js')}></script>
    <script is:inline src={withBase('assets/vendor/swiper/swiper-bundle.min.js')}></script>
    <script is:inline src={withBase('assets/vendor/typed.js/typed.min.js')}></script>
    <script is:inline src={`${withBase('assets/js/main.js')}?v=6.0.6`} defer></script>
    <script is:inline src={`${withBase('assets/js/index.js')}?v=6.0.3`} defer></script>
    <script is:inline src={`${withBase('assets/js/particles.js')}?v=6.0.0`} defer></script>
  </body>
</html>
