---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<footer id="footer">
  <div class="container">
    <div class="copyright">
      &copy; <span id="demo" onclick="version()">{t.footer.copyright}</span><strong></strong>
    </div>
  </div>
</footer>

<a href="#" class="back-to-top d-flex align-items-center justify-content-center"
  ><i class="bi bi-arrow-up-short"></i></a
>
