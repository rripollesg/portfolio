---
import type { Dictionary, Locale } from '../i18n';
import { withBase } from '../utils/paths';

interface Props {
  t: Dictionary;
  locale: Locale;
}

const { t, locale } = Astro.props;
const homeHref = locale === 'es' ? withBase('/') : withBase('/en/');
const switchHref = withBase(t.nav.switchLangHref);
---

<i class="bi bi-list mobile-nav-toggle d-xl-none"></i>

<header id="header">
  <div class="d-flex flex-column">
    <div class="profile">
      <img
        src={withBase('assets/img/profile3-img.webp')}
        alt={t.profile.imageAlt}
        class="img-fluid rounded-circle"
        width="600"
        height="600"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <h1 class="text-light"><a href={homeHref}>{t.profile.name}</a></h1>
      <div class="social-links mt-3 text-center">
        <a href={t.social.phone} class="facebook" aria-label="Phone"><i class="bx bx-phone"></i></a>
        <a href={t.social.email} class="google-plus" aria-label="Email"><i class="fa fa-envelope"></i></a>
        <a href={t.social.linkedin} class="linkedin" aria-label="LinkedIn"><i class="bx bxl-linkedin"></i></a>
        <a href={t.social.skype} class="twitter" aria-label="Skype"><i class="bx bxl-skype"></i></a>
        <a href={t.social.github} class="github" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
      </div>
    </div>

    <nav id="navbar" class="nav-menu navbar">
      <ul>
        <li>
          <a href="#hero" class="nav-link scrollto active"
            ><i class="bx bx-home"></i> <span>{t.nav.home}</span></a
          >
        </li>
        <li>
          <a href="#about" class="nav-link scrollto"
            ><i class="bx bx-user"></i> <span>{t.nav.about}</span></a
          >
        </li>
        <li>
          <a href="#resume" class="nav-link scrollto"
            ><i class="bx bx-briefcase"></i> <span>{t.nav.resume}</span></a
          >
        </li>
        <li>
          <a href="#portfolio" class="nav-link scrollto"
            ><i class="bx bx-photo-album"></i> <span>{t.nav.portfolio}</span></a
          >
        </li>
        <li>
          <a href="#skills" class="nav-link scrollto"
            ><i class="bx bx-brain"></i> <span>{t.nav.skills}</span></a
          >
        </li>
        <li>
          <a href={withBase(t.nav.cvFile)} target="_blank" rel="noopener noreferrer"
            ><i class="fas fa-download"></i> {t.nav.downloadCv}</a
          >
        </li>
        <li>
          <a href={switchHref}
            ><img src={withBase(t.nav.switchLangFlag)} alt={t.nav.switchLangLabel} />
            &nbsp;{t.nav.switchLangLabel}</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>
