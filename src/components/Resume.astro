---
import type { Dictionary } from '../i18n';
import EducationBlock from './EducationBlock.astro';
import JobsList from './JobsList.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const r = t.resume;
---

<section id="resume" class="resume section-bg">
  <div class="container">
    <div class="section-title">
      <h2>{r.title}</h2>
      <p>{r.intro}</p>
    </div>

    <div class="row">
      <div class="col-lg-12 d-block d-md-block d-lg-none">
        <ul class="nav nav-pills mb-3" role="tablist">
          <li class="nav-item" role="presentation">
            <button
              class="nav-link active"
              id="resume-tab-education"
              data-bs-toggle="pill"
              data-bs-target="#tab1"
              type="button"
              role="tab"
              aria-controls="tab1"
              aria-selected="true"
            >
              {r.educationTab}
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              id="resume-tab-experience"
              data-bs-toggle="pill"
              data-bs-target="#tab2"
              type="button"
              role="tab"
              aria-controls="tab2"
              aria-selected="false"
            >
              {r.experienceTab}
            </button>
          </li>
        </ul>

        <div class="tab-content">
          <div
            class="tab-pane fade show active"
            id="tab1"
            role="tabpanel"
            aria-labelledby="resume-tab-education"
            tabindex="0"
          >
            <EducationBlock t={t} accordionId="accordionMobile" />
          </div>
          <div
            class="tab-pane fade"
            id="tab2"
            role="tabpanel"
            aria-labelledby="resume-tab-experience"
            tabindex="0"
          >
            <JobsList t={t} />
          </div>
        </div>
      </div>

      <div class="col-lg-6 d-none d-md-none d-lg-block" data-aos="fade-up">
        <EducationBlock t={t} accordionId="accordionDesktop" />
      </div>
      <div class="col-lg-6 d-none d-md-none d-lg-block" data-aos="fade-up" data-aos-delay="100">
        <JobsList t={t} />
      </div>
    </div>
  </div>
</section>
