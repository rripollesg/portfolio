---
import type { ResumeItem } from '../i18n';
import { withBase } from '../utils/paths';

interface Props {
  items: ResumeItem[];
  viewLabel: string;
  microsoftLabel: string;
  microsoft: ResumeItem[];
  accordionId: string;
}

const { items, viewLabel, microsoftLabel, microsoft, accordionId } = Astro.props;
const before = items.slice(0, 7);
const after = items.slice(7);
---

{
  before.map((item) => (
    <div class="resume-item">
      <h4>{item.title}</h4>
      <h5>{item.period}</h5>
      <p>
        <em>{item.place}</em>
      </p>
          {item.file && (
            <p>
              <a href={withBase(item.file)} target="_blank" rel="noopener noreferrer">{viewLabel}</a>
            </p>
          )}
        </div>
      ))
    }

<div class="resume-item">
  <div class="accordion" id={accordionId}>
    <div class="accordion-item">
      <h2 class="accordion-header" id={`${accordionId}-heading`}>
        <button
          class="accordion-button collapsed"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target={`#${accordionId}-collapse`}
          aria-expanded="false"
          aria-controls={`${accordionId}-collapse`}
        >
          {microsoftLabel}
        </button>
      </h2>
      <div
        id={`${accordionId}-collapse`}
        class="accordion-collapse collapse"
        aria-labelledby={`${accordionId}-heading`}
        data-bs-parent={`#${accordionId}`}
      >
        <div class="accordion-body">
          {
            microsoft.map((item) => (
              <div class="mb-3">
                <h5>{item.title}</h5>
                <p>
                  <em>{item.period}</em>
                </p>
                {item.file && (
                  <p>
                    <a href={withBase(item.file)} target="_blank" rel="noopener noreferrer">
                      {viewLabel}
                    </a>
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

{
  after.map((item) => (
    <div class="resume-item">
      <h4>{item.title}</h4>
      <h5>{item.period}</h5>
      <p>
        <em>{item.place}</em>
      </p>
      {item.file && (
        <p>
          <a href={withBase(item.file)} target="_blank" rel="noopener noreferrer">{viewLabel}</a>
        </p>
      )}
    </div>
  ))
}
