---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const a = t.about;
---

<section id="about" class="about">
  <div class="container">
    <div class="section-title">
      <h2>{a.title}</h2>
    </div>

    <div class="row">
      <div class="col-lg-12 pt-4 pt-lg-0 content" data-aos="fade-left">
        <h3>{a.headline}</h3>
        <div class="row">
          <div class="col-lg-6">
            <ul>
              {
                a.showBirth && (
                  <li>
                    <i class="fa-regular fa-calendar"></i>{' '}
                    <strong>{a.birthLabel}</strong> <span>{a.birthValue}</span>
                  </li>
                )
              }
              <li>
                <i class="fa-solid fa-location-dot"></i>{' '}
                <strong>{a.locationLabel}</strong> {a.locationValue}
              </li>
              <li>
                <i class="fa-solid fa-circle-info"></i>{' '}
                <strong>{a.extraLabel}</strong>
              </li>
              {a.extras.map((item) => <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{item}</li>)}
            </ul>
          </div>
          <div class="col-lg-6">
            <ul>
              <li><p>{a.summary}</p></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
