---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const a = t.about;
---

<section id="about" class="about">
  <div class="container">
    <div class="section-title">
      <h2>{a.title}</h2>
    </div>

    <div class="row">
      <div class="col-lg-12 pt-4 pt-lg-0 content" data-aos="fade-left">
        <h3>{a.headline}</h3>
        <div class="row gy-4">
          <div class="col-lg-5">
            <ul class="about-meta">
              {
                a.showBirth && (
                  <li>
                    <i class="fa-regular fa-calendar"></i>{' '}
                    <strong>{a.birthLabel}</strong> <span>{a.birthValue}</span>
                  </li>
                )
              }
              <li>
                <i class="fa-solid fa-location-dot"></i>{' '}
                <strong>{a.locationLabel}</strong> {a.locationValue}
              </li>
            </ul>
            <p class="about-extras-label">{a.extraLabel}</p>
            <ul class="about-chips">
              {a.extras.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="col-lg-7">
            <p class="about-summary">{a.summary}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
