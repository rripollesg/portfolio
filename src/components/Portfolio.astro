---
import type { Dictionary } from '../i18n';
import { withBase } from '../utils/paths';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const p = t.portfolio;

const isVideoDemo = (demo?: string) =>
  !!demo && /\.(mp4|webm|ogg)(\?.*)?$/i.test(demo);
---

<section id="portfolio" class="portfolio section-bg">
  <div class="container">
    <div class="section-title">
      <h2>{p.title}</h2>
    </div>

    <ul id="portfolio-flters" class="portfolio-filters" data-aos="fade-up">
      <li data-filter="*" class="filter-active">{p.filterAll}</li>
      <li data-filter=".filter-web">{p.filterWeb}</li>
      <li data-filter=".filter-app">{p.filterApps}</li>
    </ul>

    <div class="row gy-4 portfolio-container" data-aos="fade-up" data-aos-delay="100">
      {
        p.projects.map((project) => {
          const layout = project.layout ?? (project.filter.includes('filter-app') ? 'phone' : 'web');
          const videoDemo = isVideoDemo(project.demo) ? withBase(project.demo!) : undefined;
          const externalDemo =
            project.demo && !videoDemo
              ? /^https?:\/\//i.test(project.demo)
                ? project.demo
                : withBase(project.demo)
              : undefined;
          return (
            <div class={`col-lg-4 col-md-6 portfolio-item ${project.filter}`}>
              <article
                class={`portfolio-card portfolio-card-${layout}`}
                data-title={project.title}
                data-subtitle={project.subtitle}
                data-description={project.description}
                data-tech={project.tech.join('|')}
                data-layout={layout}
                data-gallery={project.gallery.map((g) => withBase(g)).join('|')}
                data-video={videoDemo || undefined}
              >
                <div class={`portfolio-cover-wrap ${layout === 'phone' ? 'is-phone' : 'is-web'}`}>
                  {layout === 'phone' ? (
                    <div class="phone-frame" aria-hidden="true">
                      <img
                        src={withBase(project.cover)}
                        class="portfolio-cover"
                        alt={project.title}
                      />
                    </div>
                  ) : (
                    <img
                      src={withBase(project.cover)}
                      class="portfolio-cover"
                      alt={project.title}
                    />
                  )}
                </div>
                <div class="portfolio-card-body">
                  <span class="portfolio-badge">{project.badge}</span>
                  <h3>{project.title}</h3>
                  <div class="portfolio-actions">
                    <button class="portfolio-open" type="button">
                      {p.openGallery}
                    </button>
                    {videoDemo && (
                      <button class="portfolio-demo-video" type="button">
                        {p.demo}
                      </button>
                    )}
                    {externalDemo && (
                      <a href={externalDemo} target="_blank" rel="noopener noreferrer">
                        {p.demo}
                      </a>
                    )}
                  </div>
                </div>
              </article>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<div id="portfolioModal" class="portfolio-modal" aria-hidden="true">
  <div class="portfolio-modal-inner">
    <button type="button" class="portfolio-modal-close" aria-label={p.closeGallery}>
      <i class="bi bi-x-lg"></i>
    </button>
    <h3 class="portfolio-modal-title"></h3>
    <p class="portfolio-modal-subtitle"></p>
    <p class="portfolio-modal-description"></p>
    <div class="portfolio-modal-tech"></div>
    <div class="portfolio-modal-stage">
      <div class="swiper portfolio-modal-main-swiper">
        <div class="swiper-wrapper"></div>
      </div>
      <div class="portfolio-modal-video-wrap" hidden>
        <video class="portfolio-modal-video" controls playsinline preload="metadata"></video>
      </div>
    </div>
    <div class="swiper portfolio-modal-thumbs-swiper">
      <div class="swiper-wrapper"></div>
    </div>
  </div>
</div>
