---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const s = t.skills;
---

<section id="skills" class="skills section-bg">
  <div class="container">
    <div class="section-title">
      <h2>{s.title}</h2>
    </div>
    <div class="row skills-content">
      <div class="col-12 col-lg-6" data-aos="fade-up">
        <div class="panel-box">
          <div class="tab-menu">
            <ul class="nav nav-tabs flex-wrap" id="mytab" role="tablist">
              {
                s.tabs.map((tab, i) => (
                  <li class="nav-item" role="presentation">
                    <button
                      class:list={['nav-link', i === 0 && 'active']}
                      id={`${tab.id}-tab`}
                      data-bs-toggle="tab"
                      data-bs-target={`#${tab.id}`}
                      type="button"
                      role="tab"
                      aria-controls={tab.id}
                      aria-selected={i === 0 ? 'true' : 'false'}
                    >
                      {tab.label}
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="tab-content skills-tab-content" id="myTabContent">
            {
              s.tabs.map((tab, i) => (
                <div
                  class:list={['tab-pane', 'fade', i === 0 && 'show', i === 0 && 'active']}
                  id={tab.id}
                  role="tabpanel"
                  aria-labelledby={`${tab.id}-tab`}
                >
                  <div class="skills-icons-grid">
                    {(s.groups[tab.id] ?? []).map((icon) =>
                      icon.href ? (
                        <a href={icon.href} class="skills-icon-link" aria-label={icon.iconClass}>
                          <i class={`skill-icon ${icon.iconClass}`}></i>
                        </a>
                      ) : (
                        <span class="skills-icon-link">
                          <i class={`skill-icon ${icon.iconClass}`}></i>
                        </span>
                      )
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-6" data-aos="fade-up" data-aos-delay="100">
        <div class="panel-box">
          <h3>{s.languagesTitle}</h3>
          {s.languages.map((lang) => <p>{lang}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
